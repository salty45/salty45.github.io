<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lab Name - Home</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Optional custom styling */
        .navbar-brand img {
            height: 40px; /* Adjust logo height as needed */
        }
        .carousel-item img {
            height: 400px; /* Fixed height for carousel images */
            object-fit: cover; /* Ensures images scale nicely */
            border-radius: 8px;
        }
        .about-section {
            background-color: #f8f9fa;
            border-radius: 8px;
        }
    </style>
</head>
<body>

    <!-- Top Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm sticky-top">
        <div class="container">
            <!-- Navbar Logo / Brand on the Left -->
            <a class="navbar-brand d-flex align-items-center fw-bold" href="#">
                <!-- Replace src with your actual logo image URL -->
                <img src="https://github.com/salty45/salty45.github.io/blob/master/Gemini_Generated_Image_3lruj83lruj83lru.png" alt="Lab Logo" class="me-2">
                <span>[Your Lab Name]</span>
            </a>

            <!-- Mobile Toggle Button -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Navbar Links on the Right -->
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-semibold" href="#people">People</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-semibold" href="#projects">Projects</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-semibold" href="#publications">Publications</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content Container -->
    <main class="container my-5">

        <!-- Centered Carousel Section -->
        <section class="row justify-content-center mb-5">
            <div class="col-lg-10">
                <div id="labCarousel" class="carousel slide shadow-sm" data-bs-ride="carousel">
                    <!-- Carousel Indicators -->
                    <div class="carousel-indicators">
                        <button type="button" data-bs-target="#labCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                        <button type="button" data-bs-target="#labCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
                        <button type="button" data-bs-target="#labCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
                    </div>

                    <!-- Carousel Slides -->
                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <img src="https://via.placeholder.com/1000x400/007bff/ffffff?text=Research+Highlight+1" class="d-block w-100" alt="Slide 1">
                            <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded p-2">
                                <h5>Cutting-Edge Research</h5>
                                <p>Exploring advanced topics in science and technology.</p>
                            </div>
                        </div>
                        <div class="carousel-item">
                            <img src="https://via.placeholder.com/1000x400/28a745/ffffff?text=Latest+Publication" class="d-block w-100" alt="Slide 2">
                            <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded p-2">
                                <h5>New Publication Released</h5>
                                <p>Check out our latest paper published in a top journal.</p>
                            </div>
                        </div>
                        <div class="carousel-item">
                            <img src="https://via.placeholder.com/1000x400/6c757d/ffffff?text=Lab+Team" class="d-block w-100" alt="Slide 3">
                            <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded p-2">
                                <h5>Our Team at Work</h5>
                                <p>Collaborating to solve complex problems.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Carousel Controls -->
                    <button class="carousel-control-prev" type="button" data-bs-target="#labCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#labCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>
        </section>

        <!-- About Section (Immediately below the Carousel) -->
        <section id="about" class="about-section p-4 p-md-5 my-4 border">
            <div class="row">
                <div class="col-lg-12 text-center mb-3">
                    <h2 class="fw-bold">About Our Lab</h2>
                    <hr class="w-25 mx-auto text-primary" style="height: 3px;">
                </div>
            </div>
            <div class="row fs-5 text-muted">
                <div class="col-lg-12">
                    <p>
                        Welcome to the <strong>[Your Lab Name]</strong> at <strong>[Your University/Institution]</strong>. 
                        Our research focuses on [brief description of core research areas, e.g., computational biology, machine learning, neuroscience].
                    </p>
                    <p>
                        Our mission is to advance scientific knowledge through interdisciplinary collaboration, 
                        innovative methodologies, and open science. We are dedicated to mentoring the next generation 
                        of researchers and delivering impactful contributions to the field.
                    </p>
                </div>
            </div>
        </section>

    </main>

    <!-- Footer -->
    <footer class="text-center text-muted py-4 border-top">
        <p class="mb-0">&copy; 2026 [Your Lab Name]. All rights reserved.</p>
    </footer>

    <!-- Bootstrap 5 JS Bundle (Includes Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
